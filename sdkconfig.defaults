# Target: ESP32-C6FH4 (4MB flash, 512KB SRAM, no PSRAM)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Console over native USB-Serial-JTAG (/dev/ttyACM0)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Performance
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Filesystem (SD card ROMs)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Bluetooth: Bluepad32 v4.2.0 (BTstack is the host; ESP32-C6 is BLE-only)
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_LE_MAX_CONNECTIONS=3
# ESP32-C6 BLE controller RAM trimming (512 KB SRAM, no PSRAM, HID traffic only)
CONFIG_BT_LE_ACL_BUF_COUNT=6
CONFIG_BT_LE_HCI_EVT_HI_BUF_COUNT=12
CONFIG_BT_LE_HCI_EVT_LO_BUF_COUNT=4
CONFIG_BT_LE_MSYS_1_BLOCK_COUNT=8
CONFIG_BT_LE_MSYS_2_BLOCK_COUNT=12
CONFIG_BLUEPAD32_PLATFORM_CUSTOM=y
CONFIG_BLUEPAD32_MAX_DEVICES=2
# CONFIG_BLUEPAD32_USB_CONSOLE_ENABLE is not set
CONFIG_BTSTACK_AUDIO=n

# Wi-Fi phone controller (SoftAP + web page + WebSocket).
# The Wi-Fi stacks are only started on demand (`wpad on`), but lwIP/Wi-Fi
# static pools are always reserved, so keep them small for the 512 KB SRAM.
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=5
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
# mgmt send buffers are only needed for power-save multicast buffering; 8 is plenty
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_LWIP_MAX_SOCKETS=6
CONFIG_LWIP_TCP_WND_DEFAULT=4304
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=4304

# Misc
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_ESP_TASK_WDT_PANIC=n
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
